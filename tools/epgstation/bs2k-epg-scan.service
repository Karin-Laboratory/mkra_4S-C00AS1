[Unit]
Description=Collect ordinary BS broadcast EIT for EPGStation
After=network-online.target bs4k-epg-proxy.service
Wants=network-online.target
[Service]
Type=oneshot
User=bs4k-epg
Group=bs4k-epg
WorkingDirectory=/opt/bs4k-epg
Environment=TZ=Asia/Tokyo
ExecStart=/usr/bin/flock -n -E 0 /var/lib/bs4k-epg/scan.lock /usr/bin/node /opt/bs4k-epg/scan-bs.cjs
TimeoutStartSec=100
